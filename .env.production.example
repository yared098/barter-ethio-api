# Copy to .env.production and replace every example value before deploying.
# Generate secrets with: openssl rand -hex 32

# Use a hex value so it is safe to embed in the PostgreSQL connection URL.
POSTGRES_PASSWORD=replace-with-a-strong-unique-database-password

# Host port for a reverse proxy such as Nginx (API stays bound to localhost).
API_PORT=3000

# Required application settings.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
CORS_ORIGINS=https://your-frontend-domain.example

# Optional integrations.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_SECRET=
# HTTPS base route for Telegram offer chats, without an offer ID.
FRONTEND_URL=https://your-frontend-domain.example
TELEGRAM_WEB_APP_URL=https://your-frontend-domain.example/chat
OPENAI_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Production defaults; keep TRUST_PROXY=true when using Nginx or another proxy.
REDIS_PREFIX=barter:
CACHE_TTL_SECONDS=60
MAX_BODY_SIZE=5mb
TRUST_PROXY=true
